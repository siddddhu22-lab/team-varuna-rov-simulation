<?xml version="1.0"?>
<sdf version="1.8">
  <world name="team_varuna_underwater">

    <!-- 1. PHYSICS ENGINE -->
    <physics name="underwater_physics" type="dart">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <!-- 2. REQUIRED GAZEBO SYSTEMS -->
    <plugin filename="gz-sim-physics-system"
            name="gz::sim::systems::Physics"/>

    <plugin filename="gz-sim-user-commands-system"
            name="gz::sim::systems::UserCommands"/>

    <plugin filename="gz-sim-scene-broadcaster-system"
            name="gz::sim::systems::SceneBroadcaster"/>

            
<!-- CRITICAL: This is required to activate cameras, IMUs, and ray sensors -->
    <plugin filename="gz-sim-sensors-system"
            name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <plugin filename="gz-sim-imu-system"
            name="gz::sim::systems::Imu"/>

    <plugin filename="gz-sim-air-pressure-system"
            name="gz::sim::systems::AirPressure"/>

    <!-- Buoyancy: Archimedes' principle -->
    <plugin filename="gz-sim-buoyancy-system"
            name="gz::sim::systems::Buoyancy">

    <graded_buoyancy>
        <default_density>1000</default_density>

        <!-- Above z = 0, the fluid is air -->
        <density_change>
        <above_depth>0</above_depth>
        <density>1</density>
        </density_change>
    </graded_buoyancy>

    </plugin>

    <!-- 3. GRAVITY -->
    <gravity>0 0 -9.81</gravity>

    <!-- 4. VISUAL ENVIRONMENT -->
    <scene>
      <ambient>0.35 0.40 0.48 1</ambient>
      <background>0.08 0.16 0.24 1</background>
      <shadows>true</shadows>
    </scene>

    <!-- 5. LIGHTING -->
    <light name="sun" type="directional">
      <pose>0 0 8 0 0 0</pose>
      <cast_shadows>true</cast_shadows>
      <diffuse>0.8 0.85 0.9 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.3 0.2 -1</direction>
    </light>

    <!-- 6. POOL: 10 m x 10 m, 5 m deep -->
    <model name="pool">
      <static>true</static>

      <!-- Floor: top surface at Z = -5 m -->
      <link name="floor">
        <pose>0 0 -5.1 0 0 0</pose>

        <collision name="floor_collision">
          <geometry>
            <box>
              <size>10 10 0.2</size>
            </box>
          </geometry>
        </collision>

        <visual name="floor_visual">
          <geometry>
            <box>
              <size>10 10 0.2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.16 0.23 0.27 1</ambient>
            <diffuse>0.22 0.30 0.34 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- X-positive wall -->
      <link name="wall_x_positive">
        <pose>5.1 0 -2.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 10 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 5</size></box></geometry>
          <material>
            <ambient>0.12 0.25 0.32 1</ambient>
            <diffuse>0.16 0.34 0.42 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- X-negative wall -->
      <link name="wall_x_negative">
        <pose>-5.1 0 -2.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>0.2 10 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>0.2 10 5</size></box></geometry>
          <material>
            <ambient>0.12 0.25 0.32 1</ambient>
            <diffuse>0.16 0.34 0.42 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Y-positive wall -->
      <link name="wall_y_positive">
        <pose>0 5.1 -2.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10 0.2 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 5</size></box></geometry>
          <material>
            <ambient>0.12 0.25 0.32 1</ambient>
            <diffuse>0.16 0.34 0.42 1</diffuse>
          </material>
        </visual>
      </link>

      <!-- Y-negative wall -->
      <link name="wall_y_negative">
        <pose>0 -5.1 -2.5 0 0 0</pose>
        <collision name="collision">
          <geometry><box><size>10 0.2 5</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>10 0.2 5</size></box></geometry>
          <material>
            <ambient>0.12 0.25 0.32 1</ambient>
            <diffuse>0.16 0.34 0.42 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 7. WATER SURFACE MARKER: visual only -->
    <model name="water_surface_marker">
      <static>true</static>
      <link name="surface">
        <visual name="surface_visual">
          <pose>0 0 0 0 0 0</pose>
          <geometry>
            <box><size>10 10 0.01</size></box>
          </geometry>
          <material>
            <ambient>0.0 0.35 0.55 0.18</ambient>
            <diffuse>0.0 0.45 0.65 0.18</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <!-- Temporary buoyancy test object -->
    <!-- <model name="buoyancy_test">
    <pose>0 0 -1 0 0 0</pose>

    <link name="body">

        <inertial>
        <mass>100</mass>
        <inertia>
            <ixx>4.1667</ixx>
            <iyy>4.1667</iyy>
            <izz>4.1667</izz>
        </inertia>
        </inertial>

        <collision name="body_collision">
        <geometry>
            <box>
            <size>0.5 0.5 0.5</size>
            </box>
        </geometry>
        </collision>

        <visual name="body_visual">
        <geometry>
            <box>
            <size>0.5 0.5 0.5</size>
            </box>
        </geometry>

